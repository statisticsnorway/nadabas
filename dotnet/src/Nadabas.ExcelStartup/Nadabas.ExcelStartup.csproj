<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Use the explicit net48 package on every host, regardless of installed targeting packs. -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ExcelDnaCreate32BitAddIn>true</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
    <StartupManifest Condition="'$(StartupManifest)' == ''">startup-manifest.txt</StartupManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="$(StartupManifest)" LogicalName="Nadabas.StartupManifest" />
    <Compile Include="../Nadabas.PackageUpdate/PublisherTrust.cs" Link="PublisherTrust.cs" />
  </ItemGroup>
</Project>
