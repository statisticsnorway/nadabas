<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="update-text.json" LogicalName="Nadabas.UpdateText.json" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <ProjectReference Include="../Nadabas.PackageUpdate/Nadabas.PackageUpdate.csproj" />
    <ProjectReference Include="../Nadabas.VersionStore/Nadabas.VersionStore.csproj" />
  </ItemGroup>
</Project>
